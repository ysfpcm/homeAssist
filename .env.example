# -----------------------------------------------------------------------------
# Home Assistant Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to '.env' in the same directory and fill in the values below.

# Text-to-Speech (TTS) Configuration
# Supported providers: 
#   - terminal : just prints responses to the console (default)
#   - pyttsx3  : local offline TTS using your system's native engine (SAPI5/NSSpeech)
#   - kokoro   : local high-quality neural TTS (Kokoro-82M model - sounds like OpenAI/ElevenLabs)
#   - piper    : local high-speed neural TTS (highly efficient on CPUs)
#   - advanced : placeholder for cloud APIs (OpenAI/ElevenLabs)
TTS_PROVIDER=terminal

# Picovoice Porcupine Access Key for local Wake Word detection ("Echo" / "Jarvis")
# Get a free API Key from: https://console.picovoice.ai/
PICOVOICE_API_KEY=your_picovoice_access_key_here

# Telegram Bot API Token for remote access and alerts
# Create a bot via BotFather on Telegram to get a token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
